{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nugget-nihongo",
  "main": "worker.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build"
  }
}
