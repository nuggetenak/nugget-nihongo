{
  "name": "nugget-nihongo",
  "version": "15.16.0",
  "description": "Hybrid PWA for learning Japanese — JLPT N5 to N1, targeting Indonesian speakers",
  "private": true,
  "license": "MIT",
  "author": "Nugget Nihongo <nugget.nihongo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuggetenak/nugget-nihongo.git"
  },
  "homepage": "https://nuggetenak.github.io/nugget-nihongo/",
  "keywords": ["jlpt", "japanese", "language-learning", "pwa", "vanilla-js", "supabase", "cloudflare"],
  "scripts": {
    "build": "node scripts/merge-vocab.js && node scripts/merge-grammar.js && node tests/run.js && vite build",
    "test": "node tests/run.js",
    "validate": "node tests/run.js",
    "dev": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "start": "npx http-server dist -p 3000 -c-1",
    "serve": "npx http-server dist -p 3000 -c-1 --push-state",
    "lint:data": "node -e \"require('./tests/run.js')\"",
    "check:version": "node -e \"const fs=require('fs');const v=fs.readFileSync('public/js/core/version.js','utf8').match(/APP_VERSION\\s*=\\s*'(v[\\d.]+)'/)[1];const s=fs.readFileSync('public/sw.js','utf8').match(/nihongo-(v[\\d.]+)/)[1];console.log(v===s?'✅ '+v:'❌ MISMATCH '+v+' vs '+s);if(v!==s)process.exit(1)\"",
    "deploy": "wrangler pages deploy dist",
    "preview": "wrangler pages dev dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.81.0"
  }
}
